NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Generate long random values; ENCRYPTION_KEY must be exactly 32 bytes.
JWT_SECRET=134erfgbnzerc45e6789jinukhbjgchfd
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Google OAuth web application credentials. Add API_URL/auth/google/callback
# as an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Ethereal SMTP credentials (create a test account at https://ethereal.email).
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Worker and provider guardrails
WORKER_CONCURRENCY=10
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
EMAIL_MAX_ATTEMPTS=5

# Slack OAuth v2 app with incoming-webhook scope.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback
